{{define "content"}}

<div class="row" style="margin-top: 2rem;">
  <div class="col s12 m8 l9 offset-m2 offset-l1">
    <div class="main-content">
      <h5>Checkout</h5>
      <p>Please review your order and submit when ready.</p>

      <div class="order-sidebar" style="background-color:transparent; box-shadow:none; padding:0;">
        <h6>Your Order</h6>
        {{ if .AlertMessage }}
        <div class="flash-message {{.AlertType}}">
            {{.AlertMessage}}
            <button class="close-btn" onclick="this.parentElement.style.display='none';">&times;</button>
        </div>
        {{ end }}
        <ul id="orderList"></ul>
        <p id="orderTotal">Total: $0.00</p>
        <form id="orderFormCheckout" action="/orders" method="POST">
            {{ $.CSRFField  }}

            <!-- If admin, show input for walk-in customer name -->
            {{ if eq .CurrentUserRole "admin" }}
            <div class="input-field">
                <input id="walkInFullName" name="walkInFullName" type="text" required class="white-text">
                <label for="walkInFullName" class="white-text">Customer Name</label>
            </div>
            <div class="input-field">
                <input id="walkInPhone" name="walkInPhone" type="tel" class="white-text">
                <label for="walkInPhone" class="white-text">Customer Phone</label>
            </div>
            {{ end }}

            <!-- if user is not authenticate show input fields for guestUserName and guestUserPhone-->
            {{ if not .IsAuthenticated }}
            <div class="input-field">
                <input id="guestUserName" name="guestUserName" type="text" required class="white-text">
                <label for="guestUserName" class="white-text">Your Name</label>
            </div>
            <div class="input-field">
                <input id="guestUserPhone" name="guestUserPhone" type="tel" required class="white-text">
                <label for="guestUserPhone" class="white-text">Your Phone</label>
            </div>
            {{ end }}

            <!-- Hidden fields for order data -->
            <input type="hidden" name="orderData" id="orderDataCheckout">
            <button type="submit" class="btn mustard">Place Order</button>
            <a href="/" class="btn grayed-out" style="margin-left:1rem;">Back to Menu</a>
        </form>
      </div>
    </div>
  </div>
</div>

{{end}}

<script>
// Populate checkout page order list and hidden input from localStorage
document.addEventListener('DOMContentLoaded', function() {
  try {
    const orderData = JSON.parse(localStorage.getItem('blessed_order') || '[]');
    const orderList = document.getElementById('orderList');
    const orderTotal = document.getElementById('orderTotal');
    const hid = document.getElementById('orderDataCheckout');
    if (hid) hid.value = JSON.stringify(orderData || []);
    if (orderList) {
      orderList.innerHTML = '';
      let total = 0;
      orderData.forEach(item => {
        const li = document.createElement('li');
        li.textContent = `${item.qty} x ${item.name} - $${(item.price * item.qty).toFixed(2)}`;
        orderList.appendChild(li);
        total += item.price * item.qty;
      });
      if (orderTotal) orderTotal.textContent = `Total: $${total.toFixed(2)}`;
    }
  } catch (err) {
    console.error('Failed to populate checkout from localStorage', err);
  }
});
</script>
