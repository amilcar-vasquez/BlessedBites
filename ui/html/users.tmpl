{{define "content"}}
<div class="app-container" style="margin-top: 3rem;">
    <h4>User List</h4>

    {{ if .Users }}
    <table class="highlight">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone Number</th>
                <th>Role</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{ range .Users }}
            <tr>
                <td>{{ .FullName }}</td>
                <td>{{ .Email }}</td>
                <td>{{ .PhoneNo }}</td>
                <td>{{ .Role }}</td>    
                <td>
                                        <form action="/user/update/form" method="POST" style="display:inline;">
                                                {{ $.CSRFField  }}
                                                <input type="hidden" name="user_id" value="{{.ID}}">
                                                <button class="btn-small mustard" type="submit" title="Edit {{.FullName}}" aria-label="Edit {{.FullName}}">
                                                    <i class="material-icons">edit</i>
                                                </button>
                                            </form>
                                        <form action="/users/delete" method="POST" style="display:inline;">
                                                {{ $.CSRFField  }}
                                                <input type="hidden" name="user_id" value="{{.ID}}">
                                                <button class="btn-small burgundy" type="submit" title="Delete {{.FullName}}" aria-label="Delete {{.FullName}}" onclick="return confirm('Delete this user?');">
                                                    <i class="material-icons">delete</i>
                                                </button>
                                        </form>
                </td>
            </tr>
            {{ end }}
        </tbody>
    </table>
    {{ else }}
    <p>No users available.</p>
    {{ end }}
</div>
{{ end }}
